# Copy to .env and fill in real values. .env is gitignored.

# MongoDB connection string (Atlas). The database name in the path (…/news)
# is where content + uploads are stored. If unset, the server falls back to
# local-disk storage (dev only — data is lost on ephemeral/serverless hosts).
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/news?retryWrites=true&w=majority

# Admin passcode for the /admin content editor (defaults to "retro-admin" if unset).
ADMIN_KEY=change-me

# Port the API server listens on (defaults to 5174).
# API_PORT=5174
